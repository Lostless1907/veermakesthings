---
import "../styles/global.css";
import { site } from "@/data/site";
import { navigation } from "@/data/navigation";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = site.name,
  description = site.description,
  image = "/og-default.svg",
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;
const imageUrl = new URL(image, site.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Veer Makes Things" href="/rss.xml" />

    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:site_name" content={site.name} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <slot name="head" />
  </head>

  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href="/" aria-label="Veer Makes Things home">
          <span>VEER</span>
          <small>MAKES THINGS</small>
        </a>

        <nav aria-label="Primary navigation">
          {navigation.map((item) => (
            <a
              href={item.href}
              class:list={{ active: Astro.url.pathname.startsWith(item.href) }}
            >
              {item.label}
            </a>
          ))}
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <div>
          <strong>Veer Makes Things</strong>
          <p>Made with Markdown, mathematics, and questionable amounts of CSS.</p>
        </div>

        <div class="footer-links">
          <a href="/rss.xml">RSS</a>
          <a href={site.social.github}>GitHub</a>
          <a href={site.social.x}>X</a>
          <a href={site.social.instagram}>Instagram</a>
          <a href={site.social.linkedin}>LinkedIn</a>
          <a href={site.social.reddit}>Reddit</a>
        </div>
      </footer>
    </div>
  </body>
</html>

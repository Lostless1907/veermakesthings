---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import NoteCard from "@/components/NoteCard.astro";
import SocialFeed from "@/components/SocialFeed.astro";

const writing = (await getCollection("writing"))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featured = writing.filter((entry) => entry.data.featured).slice(0, 3);
const latestWriting = (featured.length ? featured : writing).slice(0, 3);

const work = (await getCollection("work"))
  .filter((entry) => !entry.data.featured || entry.data.featured)
  .slice(0, 3);

const notes = (await getCollection("notes"))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
---

<BaseLayout>
  <section class="hero">
    <p class="eyebrow">VEER MAKES THINGS</p>
    <h1>
      Mathematically mature programmer.<br />
      <em>Perpetually curious about everything else.</em>
    </h1>
    <p class="hero-copy">
      I study mathematics and computer science, research things, build software,
      write about ideas, and occasionally wander into something completely unrelated.
    </p>

    <div class="hero-links">
      <a class="button button-dark" href="/writing/">Read the writing →</a>
      <a class="text-link" href="/work/">See what I'm making</a>
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Featured</span>
        <h2>Things worth reading</h2>
      </div>
      <a href="/writing/">Everything →</a>
    </div>

    <div class="article-grid">
      {latestWriting.map((entry) => (
        <ArticleCard
          title={entry.data.title}
          description={entry.data.description}
          href={`/writing/${entry.id}/`}
          date={entry.data.pubDate}
          type={entry.data.type}
        />
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Work</span>
        <h2>Things I'm making</h2>
      </div>
      <a href="/work/">All work →</a>
    </div>

    <div class="project-grid">
      {work.map((entry) => (
        <ProjectCard
          title={entry.data.title}
          description={entry.data.description}
          href={`/work/${entry.id}/`}
          status={entry.data.status}
        />
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Notes</span>
        <h2>Small thoughts</h2>
      </div>
      <a href="/notes/">All notes →</a>
    </div>

    <div class="note-list">
      {notes.map((entry) => (
        <NoteCard
          title={entry.data.title}
          href={`/notes/${entry.id}/`}
          date={entry.data.pubDate}
        />
      ))}
    </div>
  </section>

  <SocialFeed />
</BaseLayout>

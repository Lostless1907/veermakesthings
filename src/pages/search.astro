---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Search — Veer Makes Things" description="Search the Veer Makes Things archive.">
  <section class="page-intro">
    <span class="eyebrow">Search</span>
    <h1>Find something.</h1>
    <p>Search will become useful once the archive has enough things to get lost in.</p>
  </section>

  <div class="search-placeholder">
    <input type="search" placeholder="Search the archive…" aria-label="Search the archive" disabled />
    <p>Search engine: coming later. No need to build it before there is something to search.</p>
  </div>
</BaseLayout>

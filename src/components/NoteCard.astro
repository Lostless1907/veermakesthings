---
interface Props {
  title: string;
  href: string;
  date: Date;
}

const { title, href, date } = Astro.props;
---

<a class="note-row" href={href}>
  <span>{title}</span>
  <time datetime={date.toISOString()}>
    {date.toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" })}
  </time>
</a>
